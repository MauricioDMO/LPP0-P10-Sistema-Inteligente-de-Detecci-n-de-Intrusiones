# Configuración del Backend Suricata

# Redis
BACKEND_REDIS_HOST=localhost
BACKEND_REDIS_PORT=6379
BACKEND_REDIS_DB=0
BACKEND_REDIS_CHANNEL=suricata

# Elasticsearch
BACKEND_ELASTICSEARCH_HOST=localhost
BACKEND_ELASTICSEARCH_PORT=9200
BACKEND_ELASTICSEARCH_SCHEME=http
BACKEND_ELASTICSEARCH_INDEX=suricata-*
BACKEND_ELASTICSEARCH_ENRICHED_INDEX=suricata-enriched-*
BACKEND_ELASTICSEARCH_ENRICHED_WRITE_INDEX=suricata-enriched
BACKEND_ENRICHED_INDEX_ENABLED=true

# PostgreSQL
BACKEND_DATABASE_URL=postgresql+asyncpg://suricata:suricata@localhost:5432/suricata

# JWT auth
BACKEND_JWT_SECRET=change-me
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_EXPIRES_MINUTES=480

# CORS origins allowed to send cookies to the API
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Initial admin bootstrap
BACKEND_INITIAL_ADMIN_USERNAME=admin
BACKEND_INITIAL_ADMIN_PASSWORD=admin123
BACKEND_INITIAL_ADMIN_EMAIL=admin@example.com

# FastAPI
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=8000
BACKEND_API_TITLE=Suricata Backend API
BACKEND_API_VERSION=1.0.0

# Telegram alerts
BACKEND_TELEGRAM_BOT_TOKEN=

# Threat intelligence
BACKEND_ABUSEIPDB_KEY=

# GeoIP
BACKEND_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION_IDS=GeoLite2-City
MAXMIND_UPDATE_FREQUENCY=72
