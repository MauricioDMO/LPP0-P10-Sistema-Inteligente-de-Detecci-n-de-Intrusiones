# Copy to /etc/suricata-lab/gateway.env in the Debian VM.
# Preferred for USB/KVM setups: identify interfaces by stable MAC.
# INTERNAL_MAC: interface connected to the internal router/AP/LAN.
# EXTERNAL_MAC: interface connected to the ISP/external network.
# With KVM bridge, use the MACs visible inside the VM unless the USB NICs are passed through.
INTERNAL_MAC="9c:69:d3:66:86:cc"
EXTERNAL_MAC="00:e0:4c:68:18:a3"

# Optional manual override. Leave empty to resolve from INTERNAL_MAC/EXTERNAL_MAC.
WAN_IF=""
LAN_IF=""

LAN_IP="192.168.50.1"
LAN_CIDR="192.168.50.1/24"
LAN_NET="192.168.50.0/24"

DHCP_START="192.168.50.50"
DHCP_END="192.168.50.200"
DHCP_LEASE="12h"

DNS_1="1.1.1.1"
DNS_2="8.8.8.8"

NFQUEUE_NUM="0"

PROJECT_LINK_DIR="/opt/suricata-lab"
RENDER_DIR="/etc/suricata-lab/rendered"
