# Reglas para bloquear sitios web para adultos
# Detecta y bloquea tráfico TLS, HTTP y DNS hacia sitios adultos.
# UDP/443 se bloquea para evitar QUIC/HTTP3, que puede ocultar el SNI TLS clásico.

reject udp any any -> any 443 (msg:"[BLOQUEO] QUIC/HTTP3 UDP 443"; sid:2001999; rev:1; classtype:policy-violation;)

# ===== Pornhub =====
reject tls any any -> any any (msg:"[BLOQUEO] Pornhub - TLS"; tls.sni; content:"pornhub.com"; nocase; sid:2001001; rev:2; classtype:policy-violation;)
reject tcp any any -> any 80 (msg:"[BLOQUEO] Pornhub - HTTP"; flow:established,to_server; http.host; content:"pornhub.com"; sid:2001002; rev:2; classtype:policy-violation;)
reject dns any any -> any any (msg:"[BLOQUEO] Pornhub - DNS"; dns.query; content:"pornhub.com"; nocase; sid:2001003; rev:4; classtype:policy-violation;)

