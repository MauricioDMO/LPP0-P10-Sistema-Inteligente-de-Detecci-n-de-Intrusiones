# Reglas para bloquear sitios web para adultos
# Detecta y bloquea tráfico TLS, HTTP y DNS hacia sitios adultos

# ===== Pornhub =====
reject tls $HOME_NET any -> $EXTERNAL_NET any (msg:"[BLOQUEO] Pornhub - TLS"; tls.sni; content:"pornhub.com"; nocase; sid:2001001; rev:1; classtype:policy-violation;)
reject tcp $HOME_NET any -> $EXTERNAL_NET 80 (msg:"[BLOQUEO] Pornhub - HTTP"; flow:established,to_server; http.host; content:"pornhub.com"; sid:2001002; rev:1; classtype:policy-violation;)
alert dns $HOME_NET any -> any any (msg:"[BLOQUEO] Pornhub - DNS"; dns.query; content:"pornhub.com"; nocase; sid:2001003; rev:1; classtype:policy-violation;)

